{
  "id": "weather_tokyo",
  "title": "Weather lookup (simple 1-tool)",
  "system": "You are a precise assistant with access to tools. Call a tool when it is needed; after receiving tool results, give a short final answer in English. Never invent values.",
  "user": "What is the current weather in Tokyo? I need the temperature in Celsius.",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_weather",
        "description": "Get the current weather for a city.",
        "parameters": {
          "type": "object",
          "properties": {
            "city": {"type": "string", "description": "City name"},
            "units": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature units"}
          },
          "required": ["city"],
          "additionalProperties": false
        }
      }
    }
  ],
  "tool_impl": {
    "get_weather": {
      "kind": "constant",
      "value": {"city": "Tokyo", "temp_c": 22, "condition": "partly cloudy", "humidity_pct": 61}
    }
  },
  "expected_calls": [{"name": "get_weather", "position": "first", "params": {"city": "tokyo", "units": "celsius"}}],
  "success_criteria": [
    {"type": "call_made", "name": "get_weather"},
    {
      "type": "params_exact",
      "name": "get_weather",
      "position": "first",
      "params": {"city": "tokyo", "units": "celsius"}
    },
    {"type": "answer_contains", "values": ["22"]}
  ],
  "max_rounds": 3
}
