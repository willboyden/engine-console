{
 "modes": ["nofleet"],
 "about": "routers/instances.py with no node: listing, request validation (repo_id, name, host_id, model refs), refusals, unknown instances, log/command endpoints.",
 "scenarios": [
  {"name": "instances", "steps": [
   {"method": "GET", "path": "/api/v1/instances", "expect": {"status": 200}},
   {"method": "GET", "path": "/api/v1/instances", "query": {"host": "local", "limit": "10", "cursor": "0"}, "expect": {"status": 200}},
   {"method": "GET", "path": "/api/v1/instances", "query": {"host": "BAD"}, "expect": {"status": 422}},
   {"method": "GET", "path": "/api/v1/instances", "query": {"limit": "1.5"}, "expect": {"status": 422}},
   {"method": "POST", "path": "/api/v1/instances", "json": {"engine": "vllm"}, "expect": {"status": 422}},
   {"method": "POST", "path": "/api/v1/instances", "json": {"engine": "vllm", "repo_id": "a/b", "name": "bad/name"}, "expect": {"status": 422}},
   {"method": "POST", "path": "/api/v1/instances", "json": {"engine": "vllm", "repo_id": "bad"}, "expect": {"status": 422}},
   {"method": "POST", "path": "/api/v1/instances", "json": {"engine": "vllm", "repo_id": "a/b", "host_id": "BAD"}, "expect": {"status": 422}},
   {"method": "POST", "path": "/api/v1/instances", "json": {"engine": "vllm", "repo_id": "a/b", "gpu_ids": "0"}, "expect": {"status": 422}},
   {"method": "POST", "path": "/api/v1/instances", "json": {"engine": "vllm", "repo_id": "a/b", "ttl_idle_s": "x"}, "expect": {"status": 422}},
   {"method": "POST", "path": "/api/v1/instances", "json": {"repo_id": "a/b"}, "expect": {"status": 422}},
   {"method": "POST", "path": "/api/v1/instances", "json": {"engine": "vllm", "repo_id": "a/b"}},
   {"method": "POST", "path": "/api/v1/instances", "json": {"engine": "vllm", "repo_id": "a/b", "name": "My Qwen 1.0", "params": {"max_model_len": 4096}, "gpu_ids": [0], "host_id": "local", "ttl_idle_s": 600}},
   {"method": "POST", "path": "/api/v1/instances", "json": {"engine": "nope", "repo_id": "a/b"}},
   {"method": "POST", "path": "/api/v1/instances", "json": {"engine": "vllm", "repo_id": "a/b", "profile_id": "prof_000000000000"}},
   {"method": "POST", "path": "/api/v1/instances", "json": {"engine": "llamacpp", "model": {"format": "gguf", "root_id": "r", "rel": "x.gguf"}}},
   {"method": "POST", "path": "/api/v1/instances", "json": {"engine": "vllm", "repo_id": "a/b", "host_id": "nope"}},
   {"method": "POST", "path": "/api/v1/instances", "auth": "viewer", "json": {"engine": "vllm", "repo_id": "a/b"}, "expect": {"status": 403}},
   {"method": "POST", "path": "/api/v1/instances/preflight", "json": {"engine": "vllm", "repo_id": "a/b"}},
   {"method": "POST", "path": "/api/v1/instances/preflight", "json": {"engine": "vllm", "repo_id": "a/b", "image": "evil/miner:1", "params": {"tp": 2}}},
   {"method": "POST", "path": "/api/v1/instances/preflight", "json": {"engine": "vllm", "repo_id": "bad"}, "expect": {"status": 422}},
   {"method": "POST", "path": "/api/v1/instances/preflight", "json": {"engine": "vllm", "repo_id": "a/b", "profile_id": "prof_000000000000"}},
   {"method": "POST", "path": "/api/v1/instances/discover", "json": {}, "expect": {"status": 200}},
   {"method": "POST", "path": "/api/v1/instances/discover", "expect": {"status": 200}},
   {"method": "GET", "path": "/api/v1/instances/inst_000000000000", "expect": {"status": 404}},
   {"method": "GET", "path": "/api/v1/instances/discover", "expect": {"status": 404}},
   {"method": "PATCH", "path": "/api/v1/instances/inst_000000000000", "json": {"pinned": true}, "expect": {"status": 404}},
   {"method": "PATCH", "path": "/api/v1/instances/inst_000000000000", "json": {"name": "bad/name"}, "expect": {"status": 422}},
   {"method": "PATCH", "path": "/api/v1/instances/inst_000000000000", "json": {"pinned": "yes", "ttl_idle_s": 1.0}, "expect": {"status": 404}},
   {"method": "PATCH", "path": "/api/v1/instances/inst_000000000000", "json": {"pinned": "maybe"}, "expect": {"status": 422}},
   {"method": "POST", "path": "/api/v1/instances/inst_000000000000/stop", "expect": {"status": 404}},
   {"method": "POST", "path": "/api/v1/instances/inst_000000000000/start", "expect": {"status": 404}},
   {"method": "POST", "path": "/api/v1/instances/inst_000000000000/restart", "expect": {"status": 404}},
   {"method": "DELETE", "path": "/api/v1/instances/inst_000000000000", "expect": {"status": 404}},
   {"method": "GET", "path": "/api/v1/instances/inst_000000000000/logs", "expect": {"status": 404}},
   {"method": "GET", "path": "/api/v1/instances/inst_000000000000/logs", "query": {"tail": "abc"}, "expect": {"status": 422}},
   {"method": "GET", "path": "/api/v1/instances/inst_000000000000/logs/stream", "query": {"once": "true"}, "expect": {"status": 404}},
   {"method": "GET", "path": "/api/v1/instances/inst_000000000000/logs/stream", "query": {"tail": "x"}, "expect": {"status": 422}},
   {"method": "GET", "path": "/api/v1/instances/inst_000000000000/command", "expect": {"status": 404}},
   {"method": "GET", "path": "/api/v1/instances/ext-local-x", "expect": {"status": 404}},
   {"method": "POST", "path": "/api/v1/instances/inst_000000000000/stop", "auth": "viewer", "expect": {"status": 403}}
  ]}
 ]
}
