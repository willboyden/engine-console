{
 "modes": ["nofleet"],
 "about": "SecurityMiddleware: Host allowlist (421), CSRF header and Origin checks (403), authentication (401), viewer role (403), content-type gate (415), body caps (413), security headers, method handling (405), trailing slashes. Flows from tests/core/test_security.py and test_audit_fixes.py.",
 "scenarios": [
  {"name": "host allowlist", "steps": [
   {"method": "GET", "path": "/api/v1/health", "auth": "none", "expect": {"status": 200}},
   {"method": "GET", "path": "/api/v1/health", "auth": "none", "headers": {"Host": "evil.example:8791"}, "expect": {"status": 421}},
   {"method": "GET", "path": "/", "auth": "none", "headers": {"Host": "attacker.test"}, "expect": {"status": 421}},
   {"method": "GET", "path": "/api/v1/health", "auth": "none", "headers": {"Host": "localhost:{{port}}"}, "expect": {"status": 200}},
   {"method": "GET", "path": "/api/v1/health", "auth": "none", "headers": {"Host": "LOCALHOST:{{port}}"}, "expect": {"status": 200}},
   {"method": "GET", "path": "/api/v1/health", "auth": "none", "headers": {"Host": "[::1]:{{port}}"}, "expect": {"status": 200}},
   {"method": "GET", "path": "/api/v1/health", "auth": "none", "headers": {"Host": "127.0.0.1"}, "expect": {"status": 421}},
   {"method": "GET", "path": "/api/v1/settings", "headers": {"Host": "evil.example"}, "expect": {"status": 421}},
   {"method": "POST", "path": "/api/v1/keys", "headers": {"Host": "evil.example"}, "json": {"name": "x"}, "expect": {"status": 421}}
  ]},
  {"name": "authentication", "steps": [
   {"method": "GET", "path": "/api/v1/settings", "auth": "none", "expect": {"status": 401}},
   {"method": "GET", "path": "/api/v1/settings", "auth": "bad", "expect": {"status": 401}},
   {"method": "GET", "path": "/api/v1/settings", "auth": "basic", "expect": {"status": 401}},
   {"method": "GET", "path": "/api/v1/settings", "auth": "none", "headers": {"Authorization": "Bearer "}, "expect": {"status": 401}},
   {"method": "GET", "path": "/api/v1/settings", "auth": "none", "headers": {"Authorization": "bearer {{admin_key}}"}, "expect": {"status": 200}},
   {"method": "GET", "path": "/api/v1/settings", "auth": "none", "headers": {"X-Forwarded-For": "1.2.3.4"}, "expect": {"status": 401}},
   {"method": "GET", "path": "/metrics", "auth": "none", "expect": {"status": 401}},
   {"method": "GET", "path": "/api/v1/openapi.json", "auth": "none", "expect": {"status": 401}},
   {"method": "GET", "path": "/api/v1/nope", "auth": "none", "expect": {"status": 401}},
   {"method": "GET", "path": "/", "auth": "none", "expect": {"status": 200}},
   {"method": "GET", "path": "/api/v1/hosts", "auth": "bad", "expect": {"status": 401}}
  ]},
  {"name": "csrf and origin", "steps": [
   {"method": "POST", "path": "/api/v1/keys", "auth": "none", "json": {"name": "x"}, "expect": {"status": 403}},
   {"method": "POST", "path": "/api/v1/keys", "auth": "none", "csrf": true, "json": {"name": "x"}, "expect": {"status": 401}},
   {"method": "POST", "path": "/api/v1/keys", "auth": "none", "headers": {"X-Engine-Console": "yes"}, "json": {"name": "x"}, "expect": {"status": 403}},
   {"method": "POST", "path": "/api/v1/keys", "auth": "none", "csrf": true, "headers": {"Origin": "http://evil.example"}, "json": {"name": "x"}, "expect": {"status": 403}},
   {"method": "POST", "path": "/api/v1/keys", "auth": "none", "csrf": true, "headers": {"Origin": "null"}, "json": {"name": "x"}, "expect": {"status": 403}},
   {"method": "POST", "path": "/api/v1/keys", "headers": {"Origin": "http://evil.example"}, "json": {"name": "x"}, "expect": {"status": 403}},
   {"method": "DELETE", "path": "/api/v1/keys/nope", "auth": "none", "expect": {"status": 403}},
   {"method": "PUT", "path": "/api/v1/settings", "auth": "none", "csrf": true, "json": {}, "expect": {"status": 401}},
   {"method": "POST", "path": "/api/v1/keys", "headers": {"Origin": "http://127.0.0.1:{{port}}"}, "json": {"name": "same-origin"}, "expect": {"status": 201}},
   {"method": "POST", "path": "/api/v1/keys", "csrf": true, "json": {"name": "csrf-and-bearer"}, "expect": {"status": 201}},
   {"method": "GET", "path": "/api/v1/keys", "expect": {"status": 200}}
  ]},
  {"name": "viewer role", "steps": [
   {"method": "GET", "path": "/api/v1/settings", "auth": "viewer", "expect": {"status": 200}},
   {"method": "GET", "path": "/api/v1/keys", "auth": "viewer", "expect": {"status": 403}},
   {"method": "POST", "path": "/api/v1/keys", "auth": "viewer", "json": {"name": "x"}, "expect": {"status": 403}},
   {"method": "PUT", "path": "/api/v1/settings", "auth": "viewer", "json": {}, "expect": {"status": 403}},
   {"method": "GET", "path": "/api/v1/audit", "auth": "viewer", "expect": {"status": 403}},
   {"method": "GET", "path": "/api/v1/hf/search", "auth": "viewer", "query": {"q": "x"}, "expect": {"status": 403}},
   {"method": "GET", "path": "/api/v1/hf/models/a/b", "auth": "viewer", "expect": {"status": 403}},
   {"method": "DELETE", "path": "/api/v1/conversations/x", "auth": "viewer", "expect": {"status": 403}},
   {"method": "POST", "path": "/api/v1/conversations", "auth": "viewer", "json": {"title": "viewer chat"}, "expect": {"status": 201}},
   {"method": "POST", "path": "/api/v1/conversations/", "auth": "viewer", "json": {"title": "slash"}, "expect": {"status": 403}},
   {"method": "POST", "path": "/api/v1/fit", "auth": "viewer", "json": {"engine": "vllm", "repo_id": "a/b"}},
   {"method": "POST", "path": "/api/v1/arena/matches", "auth": "viewer", "json": {"prompt": "p", "instance_a": "x", "instance_b": "y"}},
   {"method": "POST", "path": "/api/v1/arena/matches/m1/vote", "auth": "viewer", "json": {"winner": "a"}},
   {"method": "POST", "path": "/api/v1/arena/matches/m1/vote/x", "auth": "viewer", "json": {"winner": "a"}, "expect": {"status": 403}},
   {"method": "POST", "path": "/api/v1/chat/completions", "auth": "viewer", "json": {"instance_id": "nope", "messages": [{"role": "user", "content": "hi"}]}},
   {"method": "POST", "path": "/api/v1/instances/discover", "auth": "viewer", "json": {}, "expect": {"status": 403}},
   {"method": "DELETE", "path": "/api/v1/models/a/b", "auth": "viewer", "expect": {"status": 403}},
   {"method": "POST", "path": "/api/v1/library/rescan", "auth": "viewer", "json": {}, "expect": {"status": 403}},
   {"method": "GET", "path": "/api/v1/instances", "auth": "viewer", "expect": {"status": 200}},
   {"method": "GET", "path": "/metrics", "auth": "viewer", "expect": {"status": 200}}
  ]},
  {"name": "content types and body caps", "steps": [
   {"method": "POST", "path": "/api/v1/profiles/import", "headers": {"Content-Type": "text/plain"}, "raw": "name: x\nengine: vllm\n", "expect": {"status": 415}},
   {"method": "POST", "path": "/api/v1/profiles/import", "headers": {"Content-Type": "application/x-www-form-urlencoded"}, "raw": "name: x\nengine: vllm\n", "expect": {"status": 415}},
   {"method": "POST", "path": "/api/v1/profiles/import", "raw": "name: x\nengine: vllm\n", "expect": {"status": 415}},
   {"method": "POST", "path": "/api/v1/fit", "headers": {"Content-Type": "application/json"}, "raw_repeat": {"count": 1048577, "char": " "}, "expect": {"status": 413}},
   {"method": "POST", "path": "/api/v1/fit", "headers": {"Content-Type": "application/json"}, "chunked": {"parts": 2, "size": 600000, "char": "x"}, "expect": {"status": 413}},
   {"method": "POST", "path": "/api/v1/profiles/import", "headers": {"Content-Type": "text/yaml"}, "raw_repeat": {"prefix": "a: ", "count": 262142, "char": "x"}, "expect": {"status": 413}},
   {"method": "POST", "path": "/api/v1/chat/completions", "headers": {"Content-Type": "application/json"}, "raw_repeat": {"prefix": "{\"instance_id\": \"nope\", \"pad\": \"", "count": 2000000, "char": "x", "suffix": "\"}"}},
   {"method": "POST", "path": "/api/v1/chat/completions", "headers": {"Content-Type": "application/json"}, "raw_repeat": {"prefix": "{\"pad\": \"", "count": 33554433, "char": "x", "suffix": "\"}"}, "expect": {"status": 413}},
   {"method": "POST", "path": "/api/v1/keys", "headers": {"Content-Type": "application/json"}, "raw": "{bad", "expect": {"status": 422}},
   {"method": "POST", "path": "/api/v1/keys", "headers": {"Content-Type": "text/plain"}, "raw": "{\"name\":\"x\"}", "expect": {"status": 422}},
   {"method": "POST", "path": "/api/v1/keys", "raw": "{\"name\":\"x\"}", "expect": {"status": 422}},
   {"method": "POST", "path": "/api/v1/keys", "expect": {"status": 422}},
   {"method": "POST", "path": "/api/v1/keys", "json": [1, 2], "expect": {"status": 422}}
  ]},
  {"name": "methods and paths", "steps": [
   {"method": "HEAD", "path": "/api/v1/health", "auth": "none", "expect": {"status": 405}},
   {"method": "OPTIONS", "path": "/api/v1/health", "auth": "none", "expect": {"status": 405}},
   {"method": "OPTIONS", "path": "/api/v1/settings", "expect": {"status": 405}},
   {"method": "PROPFIND", "path": "/api/v1/settings", "expect": {"status": 405}},
   {"method": "TRACE", "path": "/api/v1/health", "expect": {"status": 405}},
   {"method": "DELETE", "path": "/api/v1/health", "expect": {"status": 405}},
   {"method": "GET", "path": "/api/v1/health/", "expect": {"status": 404}},
   {"method": "POST", "path": "/api/v1/keys/", "json": {"name": "x"}, "expect": {"status": 405}},
   {"method": "GET", "path": "/api/v1/nope", "expect": {"status": 404}},
   {"method": "GET", "path": "/api//v1/health", "auth": "none"},
   {"method": "GET", "path": "/api/v1/openapi.json", "compare": "json", "expect": {"status": 200}},
   {"method": "HEAD", "path": "/api/v1/openapi.json"},
   {"method": "POST", "path": "/api/v1/openapi.json", "json": {}, "expect": {"status": 405}},
   {"method": "GET", "path": "/api/v1/downloads", "query": [["limit", "1"], ["limit", "2"]], "expect": {"status": 200}},
   {"method": "GET", "path": "/api/v1/downloads", "query": {"limit": "1", "unknown": "x"}, "expect": {"status": 200}}
  ]},
  {"name": "audit is metadata-only and redacts queries", "steps": [
   {"method": "POST", "path": "/api/v1/prompts", "query": {"access_token": "hf_abcdefgh123456", "x": "1"}, "json": {"title": "t", "content": "secret prompt text"}, "expect": {"status": 201}},
   {"method": "POST", "path": "/api/v1/chat/completions", "json": {"instance_id": "nope", "messages": [{"role": "user", "content": "my private diary"}]}},
   {"method": "PUT", "path": "/api/v1/settings", "json": {"idle_ttl_s": 5, "hf_token": "hf_abcdefghijklmnop", "nested": {"api_key": "s3cr3t"}}, "expect": {"status": 200}},
   {"method": "POST", "path": "/api/v1/profiles/import", "headers": {"Content-Type": "text/yaml"}, "raw": "not: [valid"},
   {"method": "GET", "path": "/api/v1/audit", "query": {"limit": "10"}, "expect": {"status": 200}}
  ]}
 ]
}
