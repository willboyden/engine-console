# runtime state / secrets — never commit
*.db
*.db-wal
*.db-shm
*.key
secrets/
.env
.env.*
bootstrap-admin.key
# Python: the parity generators, crate-age.py and the egress proxy addon are scripts; the Python reference of the
# parity harness lives in backend/target/python-release/ (below)
.venv/
__pycache__/
*.pyc
# node: the frontend has no runtime deps; frontend/node_modules holds only the dev-only formatter (`make fmt-deps`)
node_modules/
# local artifacts
*.log
screenshots/
.DS_Store

# test fixtures are real captured logs — keep them despite the *.log rule above
!backend/crates/*/tests/data/**/*.log

# build output: the Cargo workspace (debug and release binaries, dist/ of `make node-dist`, the parity harness's
# python-release/ and crate-age cache)
/backend/target/
