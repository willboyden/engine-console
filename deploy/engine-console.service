# OPT-IN TEMPLATE: nothing installs or enables this automatically (host-level changes need a human decision).
# Generated 2026-09-23, hardened 2026-09-24, rewritten 2026-10-14 for 0.4 (the fleet) and 2026-10-28 for 0.5 (the Rust
# binaries). Never started: re-run `systemd-analyze --user verify` after editing, then read
# `journalctl --user -u engine-console` on the first start.
#
# What runs under this unit: the hub, AND the hub's own node (the `ecnode` next to it, `--stdio`, a child process), AND the ssh
# clients it starts for remote machines. The node inherits this sandbox, so it can write only to ReadWritePaths:
# the local policy's writable model roots (downloads, copies, deletes) and ~/.local/state/ecnode (the config files
# that llama.cpp templates and TensorRT-LLM options need). A path missing from the list fails at use time with
# `io_error` (... Read-only file system).
#
# Install by hand, after reading it:
#   1. `make release` in the checkout, then edit every CHANGEME: the checkout location and one ReadWritePaths entry per
#      WRITABLE model root of the local node policy (`backend/target/release/ecnode check` lists the roots and which
#      are writable).
#   2. mkdir -p ~/.local/share/engine-console ~/.config/engine-console ~/.local/state/ecnode
#      chmod 700 ~/.local/share/engine-console ~/.local/state/ecnode
#      Every ReadWritePaths entry must exist before the start, or the unit fails with a NAMESPACE error.
#   3. cp deploy/engine-console.service ~/.config/systemd/user/
#   4. systemctl --user daemon-reload && systemctl --user enable --now engine-console
#   5. systemd-analyze --user security engine-console   # review the exposure score
#
# Needs ROOTLESS Docker. In a --user unit the namespacing options below run the service in a user namespace
# (PrivateUsers=, implied by several of them and set explicitly here) where only your own uid and gid are mapped: a
# root-owned Docker socket (rootful Docker, the `docker` group) is then unreachable, while the rootless socket under
# $XDG_RUNTIME_DIR is yours and works. Hardening is otherwise partial: the home directory stays visible (read-only)
# because the hub reads hosts.json, its ssh key and the HF token file there.
[Unit]
Description=Engine Console hub (inference engine control plane, 127.0.0.1:8791)
# CHANGEME: the checkout location
Documentation=file:%h/engine-console/docs/OPERATIONS.md
# docker.service of the user manager: rootless Docker
After=docker.service
Wants=docker.service

[Service]
Type=simple
# CHANGEME: where you cloned the repository (%h = your home directory)
WorkingDirectory=%h/engine-console
# The release binary from `make release`; it serves <checkout>/frontend and starts the ecnode next to it as its local
# node. CHANGEME: the checkout location
ExecStart=%h/engine-console/backend/target/release/engine-console
# The generic settings are read only with the ENGINE_CONSOLE_ prefix (a bare HOST or PORT is ignored, with a warning).
Environment=ENGINE_CONSOLE_HOST=127.0.0.1
Environment=ENGINE_CONSOLE_PORT=8791
# Passed to the local node, which uses it only when its policy names no docker.context.
Environment=DOCKER_CONTEXT=rootless
# The hub runs ssh, ssh-keygen and the local node's tools from a fixed PATH (/usr/local/sbin:/usr/local/bin:/usr/sbin:
# /usr/bin:/sbin:/bin), never from this unit's PATH; its local node gets the same PATH and finds docker, nvidia-smi and
# ip there (a policy may name an absolute docker binary instead). If ssh lives elsewhere, link it into one of those
# folders: the release binary has no override (ENGINE_CONSOLE_TOOL_PATH exists in debug builds only).
# Egress (recommended; needs an allowlisting proxy running, see docs/OPERATIONS.md):
#Environment=EGRESS_PROXY=http://127.0.0.1:8082
#Environment=EGRESS_CA_BUNDLE=%h/.mitmproxy/mitmproxy-ca-cert.pem
#Environment=REQUIRE_EGRESS_PROXY=true
# Do NOT put HF_TOKEN here; use the 0600 file ~/.config/engine-console/hf_token (unit files are world-readable via
# `systemctl show`).
Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
PrivateUsers=yes
ProtectSystem=strict
# Writable: the data dir (SQLite, secrets/, bootstrap key), the local node's state dir, and each writable model root of
# the local node policy. HF_CACHE_DIR no longer matters: the hub keeps no model cache since 0.4.
# CHANGEME only if ENGINE_CONSOLE_DATA_DIR points elsewhere: the data dir, then the local node's state dir.
ReadWritePaths=%h/.local/share/engine-console %h/.local/state/ecnode
# CHANGEME: one line per WRITABLE model root of the local node policy; this placeholder makes the start fail until edited.
# Leave read-only roots out: the node only reads them.
ReadWritePaths=/CHANGEME/writable-model-root
# If journalctl shows the docker CLI failing to write under ~/.docker, add it:
#ReadWritePaths=%h/.docker
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Loopback for the API; AF_UNIX for the rootless docker socket; AF_INET/6 for HF, OTLP (localhost:4317) and ssh to nodes.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
ProtectClock=yes
ProtectHostname=yes
# ProtectControlGroups= and ProtectProc= are left out: systemd does not support them in per-user units.
# Files the hub creates are 0600 under this mask. Model files the local node downloads are 0600 too, which rootless
# engines read (container root is you); a root shared with other users or machines needs UMask=0022.
UMask=0077
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallArchitectures=native
# MemoryDenyWriteExecute is not set by default because it is unverified. Nothing that runs under the unit is expected to
# need writable-and-executable memory (the Rust binaries, the docker CLI, the NVML library the node loads, ssh), so it
# is a candidate: uncomment it, start the unit and check `journalctl --user -u engine-console` and the UI's host page.
#MemoryDenyWriteExecute=yes
# Egress is enforced in-app (HF allowlist) and, opt-in, by an allowlisting proxy; a systemd IP filter
# would also block the gateways' loopback ports, so none is set here.

[Install]
WantedBy=default.target
