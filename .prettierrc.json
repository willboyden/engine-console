{
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "es5",
  "overrides": [
    {"files": "*.css", "options": {"singleQuote": false}},
    {"files": "*.json", "options": {"bracketSpacing": false}},
    {
      "files": [
        "frontend/i18n/en.json",
        "backend/parity/allowed-diffs.json",
        "backend/parity/proto/expected-diffs.json"
      ],
      "options": {"tabWidth": 1}
    }
  ]
}
